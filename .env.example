# Backend secrets. Copy to .env (git-ignored). Never put these in the browser.
OPENAI_API_KEY=sk-your-key-here
# OPENAI_MODEL=gpt-5.4-mini
# OPENAI_BUDGET_USD=1.00

# Accounts (V4): Firebase Authentication. The server only needs the project ID to verify ID tokens; see docs/AUTH_FIREBASE.md.
# Leave empty to keep accounts switched off (the public site works without them).
FIREBASE_PROJECT_ID=
# Local account/role database (git-ignored). Optional.
# DS_AUTH_DB=var/dengueshield_auth.db
