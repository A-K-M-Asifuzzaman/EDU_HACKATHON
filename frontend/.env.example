# Copy to .env.local. These are browser-visible (public) keys: restrict them by domain in the provider dashboard.
NEXT_PUBLIC_MAPTILER_KEY=your_maptiler_key
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_public_token
NEXT_PUBLIC_MAP_PROVIDER=maptiler

# Accounts (V4): Firebase web config (public by design; access rules are enforced by the API). See docs/AUTH_FIREBASE.md.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
